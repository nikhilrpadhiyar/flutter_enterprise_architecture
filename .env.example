# Copy to env/development.json, env/staging.json, env/production.json
# (JSON, used with --dart-define-from-file). Never commit real values.
# ENV_NAME=development | staging | production
# API_BASE_URL=https://api.example.com/v1
# SSL_PINS=comma separated SPKI SHA-256 pins (optional)
# ENABLE_HTTP_LOGGING=true | false
