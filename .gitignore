#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Environment files (real values must never be committed)
.env
.env.*
!.env.example
env/*.json
!env/*.example.json

# Signing material
*.jks
*.keystore
key.properties

# Regenerated by `flutter pub get` and every build; never edit or commit
.flutter-plugins
.packages
pubspec_overrides.yaml
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/generated_plugins.cmake
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh

# Native build output and caches
**/Pods/
**/xcuserdata/
*.xcuserstate
.gradle/
**/.cxx/
**/.externalNativeBuild/
captures/

# Service configuration that contains keys
**/google-services.json
**/GoogleService-Info.plist

# Local tooling, editor and operating system files
.fvm/
.claude/
.fleet/
*.bak
*.orig
*.rej
*.tmp
*~
Thumbs.db
desktop.ini

# Test and coverage output
*.profraw
**/failures/

# Planning documents (kept locally, not pushed)
plans/
